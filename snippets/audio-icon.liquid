  {%- when 'phone' -%}
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M7 4h3l1.5 4-2 1.2a11 11 0 0 0 5.3 5.3l1.2-2 4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 5 6.2 2 2 0 0 1 7 4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
  {%- when 'truck' -%}
