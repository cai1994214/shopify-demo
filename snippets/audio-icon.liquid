    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M4 13v-2m4 6V7m4 13V4m4 13V7m4 6v-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'battery' -%}
