<footer class="audio-footer">
  <div class="audio-container">
    <div class="audio-footer__grid">
      <div>
        <h2>声迹音频</h2>
        <p>让好声音，陪伴更好的你。</p>
        <p>微博 · 微信 · 抖音 · 小红书 · YouTube</p>
      </div>
      <div>
        <h3>快速导航</h3>
        <ul>
          <li><a href="{{ routes.root_url }}">首页</a></li>
          <li><a href="{{ routes.collections_url }}">无线耳机</a></li>
          <li><a href="{{ routes.collections_url }}">头戴耳机</a></li>
          <li><a href="{{ routes.collections_url }}">配件</a></li>
        </ul>
      </div>
      <div>
        <h3>帮助支持</h3>
        <ul>
          <li><a href="/pages/contact">常见问题</a></li>
          <li><a href="/pages/contact">配送与物流</a></li>
          <li><a href="/policies/refund-policy">退换货政策</a></li>
          <li><a href="/pages/contact">联系我们</a></li>
        </ul>
      </div>
      <div>
        <h3>关注我们</h3>
        <p>获取最新动态与专属优惠。</p>
      </div>
      <div>
        <h3>订阅邮件</h3>
        {%- form 'customer', id: 'AudioFooterNewsletter', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="field">
            <input id="AudioFooterEmail" class="field__input" type="email" name="contact[email]" placeholder="请输入您的邮箱" required>
            <label class="field__label" for="AudioFooterEmail">请输入您的邮箱</label>
            <button type="submit" class="newsletter-form__button field__button" name="commit">→</button>
          </div>
        {%- endform -%}
      </div>
    </div>
    <div class="audio-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} 声迹音频。保留所有权利。</span>
      <span>隐私政策　服务条款　网站地图　简体中文</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "声迹页脚",
  "settings": []
}
{% endschema %}
